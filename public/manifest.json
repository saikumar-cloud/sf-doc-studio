{
  "manifest_version": 3,
  "name": "SF Doc Studio",
  "version": "1.0.0",
  "description": "AI-powered impact analyzer and documentation tool for Salesforce orgs. Bring your own Anthropic API key.",
  "permissions": [
    "storage",
    "cookies",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.salesforce.com/*",
    "https://api.anthropic.com/*"
  ],
  "action": {
    "default_title": "Open SF Doc Studio",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "116",
  "side_panel": {
    "default_path": "index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.lightning.force.com/*",
        "https://*.my.salesforce.com/*",
        "https://*.my.salesforce-setup.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
